@model IReadOnlyList<StudentManagement.Controllers.DepartmentListItem>
@{
    ViewData["Title"] = "Khoa";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">DANH MỤC ĐÀO TẠO</p>
        <h1>Khoa</h1>
        <p class="text-secondary mb-0">Quản lý các khoa và liên kết sinh viên</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" data-modal-url="@Url.Action("Form", "Import", new { entity = "departments" })" data-modal-title="Nhập khoa từ Excel">Nhập Excel</button>
        <button class="btn btn-primary" data-modal-url="@Url.Action("Form", "Departments")" data-modal-title="Thêm khoa">Thêm khoa</button>
    </div>
</section>

<div class="table-responsive data-table-wrap">
    <table class="table align-middle mb-0">
        <thead><tr><th>Tên khoa</th><th>Số sinh viên</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td class="fw-semibold">@department.Name</td>
                <td>@department.StudentCount</td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Form", "Departments", new { id = department.Id })" data-modal-title="Sửa khoa">Sửa</button>
                    <button class="btn btn-sm btn-outline-danger" data-delete-url="@Url.Action("Delete", "Departments", new { id = department.Id })">Xóa</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>