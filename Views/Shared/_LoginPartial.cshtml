@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item"><span class="nav-link">@User.Identity?.Name</span></li>
        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="nav-link btn btn-link" data-i18n="nav.logout">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register" data-i18n="nav.register">Đăng ký</a></li>
        <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login" data-i18n="nav.login">Đăng nhập</a></li>
    }
</ul>