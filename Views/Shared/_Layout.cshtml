@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentManagement</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/StudentManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar site-header navbar-expand-sm navbar-light mb-3">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Students" asp-action="Index" data-i18n="brand">HUMG | Quản lý đào tạo</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Students" asp-action="Index" data-i18n="nav.students">Sinh viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Departments" asp-action="Index" data-i18n="nav.departments">Khoa</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index" data-i18n="nav.admin">Quản trị</a></li>
                        }
                    </ul>
                    <div class="nav-tools">
                        <partial name="_LoginPartial" />
                        <form asp-controller="Culture" asp-action="SetLanguage" method="post" class="language-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "en-US" : "vi-VN")" />
                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                            <button class="language-toggle" type="submit" aria-label="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "Switch language to English" : "Chuyển sang tiếng Việt")">
                                @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "EN" : "VI")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-identity">
                <span class="footer-title" data-i18n="footer.title">HUMG | Quản lý đào tạo</span>
                <span class="footer-description" data-i18n="footer.description">Cổng thông tin quản lý sinh viên và khoa</span>
            </div>
            <div class="footer-meta">
                <span data-i18n="footer.copyright">© 2026 StudentManagement</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" data-i18n="nav.privacy">Chính sách riêng tư</a>
            </div>
        </div>
    </footer>
    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="appModalContent"></div>
        </div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast" id="appToast" role="status" aria-live="polite">
            <div class="toast-body" id="appToastMessage"></div>
        </div>
    </div>
    <form class="d-none" id="csrfForm">@Html.AntiForgeryToken()</form>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
